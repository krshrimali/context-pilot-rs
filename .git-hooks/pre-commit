#!/bin/sh
#
# Git pre-commit hook for context-pilot-rs
# Ensures Rust code is properly formatted before committing
#
# This hook will:
# 1. Check if rustfmt is installed
# 2. Run cargo fmt --check on staged Rust files
# 3. Prevent commit if formatting issues are found
# 4. Provide helpful instructions to fix formatting

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "🔍 Running pre-commit checks..."

# Check if rustfmt is installed
if ! command -v rustfmt &> /dev/null; then
    echo "${RED}❌ Error: rustfmt is not installed${NC}"
    echo "Please install it with: ${YELLOW}rustup component add rustfmt${NC}"
    exit 1
fi

# Get list of staged Rust files
STAGED_RS_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.rs$')

if [ -z "$STAGED_RS_FILES" ]; then
    echo "${GREEN}✅ No Rust files to check${NC}"
    exit 0
fi

echo "📝 Checking Rust file formatting..."

# Run cargo fmt --check
if ! cargo fmt --all -- --check > /dev/null 2>&1; then
    echo "${RED}❌ Formatting check failed!${NC}"
    echo ""
    echo "The following files need formatting:"
    echo "${YELLOW}$STAGED_RS_FILES${NC}"
    echo ""
    echo "To fix formatting issues, run:"
    echo "  ${GREEN}cargo fmt${NC}"
    echo ""
    echo "Then stage the changes and commit again:"
    echo "  ${GREEN}git add .${NC}"
    echo "  ${GREEN}git commit${NC}"
    echo ""
    echo "To bypass this check (not recommended), use:"
    echo "  ${YELLOW}git commit --no-verify${NC}"
    exit 1
fi

# Run clippy on staged files (optional, can be disabled)
echo "🔎 Running clippy checks..."
if ! cargo clippy --all-targets --all-features -- -D warnings > /dev/null 2>&1; then
    echo "${YELLOW}⚠️  Warning: Clippy found some issues${NC}"
    echo "Run ${GREEN}cargo clippy --all-targets --all-features${NC} to see details"
    echo ""
    echo "You can still commit, but consider fixing these issues."
    echo "Press Ctrl+C to abort or wait 3 seconds to continue..."
    sleep 3
fi

echo "${GREEN}✅ All pre-commit checks passed!${NC}"
exit 0
